#!/usr/bin/env python3
"""Maintain the Bluetooth Status branch of Omarchy's native menu."""

import json
import os
import re
import sys
import tempfile
from pathlib import Path

START = "// >>> omarchy-bluetooth-widgets >>>"
END = "// <<< omarchy-bluetooth-widgets <<<"
KEY = "setup.bluetooth-widgets"


def parsed(raw):
    without_comments = re.sub(r"^\s*//[^\n]*(?:\n|$)", "", raw, flags=re.M)
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", without_comments))


def rows():
    return {KEY: {
        "icon": "󰂯", "label": "Bluetooth Status", "description": "Device indicators and appearance",
        "action": "omarchy-shell shell summon redeye1011.bluetooth-status '{}'",
    }}


def edit(raw, action, entries=None):
    entries = entries or {KEY: {"icon": "󰂯", "label": "Bluetooth Status"}}
    pattern = re.compile(r"\n\s*" + re.escape(START) + r".*?" + re.escape(END) + r"\s*", re.S)
    owned = bool(pattern.search(raw))
    if action == "remove" and not owned:
        return raw
    if action == "add" and owned and all(parsed(raw).get(key) == row for key, row in entries.items()):
        if len([key for key in parsed(raw) if key == KEY or key.startswith(KEY + ".")]) == len(entries):
            return raw
    base = pattern.sub("\n", raw)
    data = parsed(base)
    if not isinstance(data, dict):
        raise ValueError("menu extension must contain an object")
    if action == "remove":
        return base
    if any(key == KEY or key.startswith(KEY + ".") for key in data):
        raise ValueError("menu ID already belongs to another entry")
    visible = re.sub(r"^\s*//[^\n]*(?:\n|$)", lambda match: " " * len(match.group()), base, flags=re.M)
    closing = visible.rfind("}")
    if closing < 0:
        raise ValueError("menu extension has no closing brace")
    prefix = re.sub(r"^\s*//[^\n]*(?:\n|$)", "", base[:closing], flags=re.M).rstrip()
    comma = "" if prefix.endswith(("{", ",")) else ","
    body = ",\n".join(f"  {json.dumps(key)}: {json.dumps(row, ensure_ascii=False)}" for key, row in entries.items())
    block = f"\n  {START}\n{comma}{body}\n  {END}\n"
    result = base[:closing] + block + base[closing:]
    parsed(result)
    return result


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("add", "remove", "check"):
        raise SystemExit("usage: menu-extension add|remove|check")
    path = Path.home() / ".config/omarchy/extensions/omarchy-menu.jsonc"
    if path.is_symlink():
        path = path.resolve()
    raw = path.read_text() if path.exists() else "{}\n"
    action = "add" if sys.argv[1] == "check" else sys.argv[1]
    result = edit(raw, action, rows() if action == "add" else None)
    if sys.argv[1] == "check":
        return
    if result == raw:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".omarchy-menu.", dir=path.parent)
    try:
        os.fchmod(fd, path.stat().st_mode & 0o777 if path.exists() else 0o644)
        with os.fdopen(fd, "w") as output:
            output.write(result)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


if __name__ == "__main__":
    main()
